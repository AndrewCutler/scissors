{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Web API",
			"type": "coreclr",
			"request": "launch",
			"program": "${workspaceFolder}/Scissors.API/bin/Debug/net10.0/Scissors.API.dll",
			"cwd": "${workspaceFolder}/Scissors.API",
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			}
		},
		{
			"name": "Desktop App",
			"type": "coreclr",
			"request": "launch",
			"program": "${workspaceFolder}/Scissors.Desktop/bin/Debug/net10.0-windows10.0.26100.0/Scissors.Desktop.dll",
			"cwd": "${workspaceFolder}/Scissors.Desktop",
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			}
		}
	],
	"compounds": [
		{
			"name": "API + Desktop",
			"configurations": ["Web API", "Desktop App"],
			"stopAll": true
		}
	]
}
